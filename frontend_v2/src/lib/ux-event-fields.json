{
  "_comment": "07 section 10.2: in-app instrumentation for phone screens. Ids, kinds, counts and milliseconds only; never names, numbers, text, addresses, coordinates or query strings. Read by services/ux_events.py and checked against frontend_v2/src/lib/ux-events.ts by its unit test.",
  "field_types": {
    "journey": {"enum": ["J-1", "J-2", "J-3", "J-4", "J-5", "J-6", "J-7", "J-8", "J-9", "J-10", "J-11", "J-12", "J-13", "J-14", "J-15", "J-16", "J-17"]},
    "screen": {"enum": ["phones", "phone-summary", "phone-records", "conversations", "media", "phone-review", "phone-patterns", "phone-analyses", "timeline-lens", "map-layer", "search", "people", "export", "intake", "prototype-summary", "prototype-conversations", "prototype-needs-a-decision"]},
    "from_screen": {"ref": "screen"},
    "to_screen": {"ref": "screen"},
    "step": {"int": [1, 50]},
    "actions": {"int": [0, 1000]},
    "ms": {"number": [0, 3600000]},
    "count": {"int": [0, 100000000]},
    "added": {"int": [0, 100000000]},
    "skipped": {"int": [0, 100000000]},
    "refused": {"int": [0, 100000000]},
    "kinds_viewed": {"int": [0, 100]},
    "kinds_total": {"int": [0, 100]},
    "panel": {"bool": true},
    "examples_opened": {"bool": true},
    "agree": {"bool": true},
    "target_kind": {"enum": ["dossier", "finding", "theory", "note", "timeline", "label", "task"]},
    "queue": {"enum": ["readings", "people-suggestions", "phone-setup", "machine-text", "review-marks"]},
    "decision_kind": {"enum": ["confirm", "correct", "skip", "link", "not-same", "unlink", "split"]},
    "reason_kind": {"enum": ["shared-number", "shared-account", "same-name-and-number", "contact-card", "owner-pattern", "other"]},
    "extraction_id": {"uuid": true}
  },
  "events": {
    "journey_start": ["journey", "screen"],
    "journey_step": ["journey", "step", "screen", "ms"],
    "journey_complete": ["journey", "ms", "actions"],
    "journey_abandon": ["journey", "step", "ms"],
    "wait": ["screen", "ms", "panel"],
    "left_before_data": ["screen", "ms"],
    "screen_switch": ["from_screen", "to_screen"],
    "search_empty": ["screen"],
    "collect": ["target_kind", "count", "added", "skipped", "refused", "ms"],
    "review_item": ["queue", "decision_kind", "ms", "examples_opened", "kinds_viewed", "kinds_total", "extraction_id"],
    "suggestion_decision": ["reason_kind", "decision_kind", "ms"],
    "second_check": ["queue", "agree"]
  },
  "required": {
    "journey_start": ["journey", "screen"],
    "journey_step": ["journey", "step"],
    "journey_complete": ["journey", "ms"],
    "journey_abandon": ["journey"],
    "wait": ["screen", "ms", "panel"],
    "left_before_data": ["screen", "ms"],
    "screen_switch": ["from_screen", "to_screen"],
    "search_empty": ["screen"],
    "collect": ["target_kind", "count"],
    "review_item": ["queue", "decision_kind", "ms"],
    "suggestion_decision": ["reason_kind", "decision_kind"],
    "second_check": ["queue", "agree"]
  },
  "decision_events": ["review_item", "suggestion_decision", "second_check"]
}
