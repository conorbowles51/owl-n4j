# lx-hostpolicy (WS-A, LOUPE-PERFORMANCE-PLAN.md). Sizes from the memory table in /mnt/owl-data/fin-wt/headless/LX-HOSTPOLICY-STATUS.md.
# Parent of loupe-live.slice (a dash in a slice name nests it), so it carries the same weights at the top level.
[Unit]
Description=Loupe (parent of the live slice)
[Slice]
CPUWeight=1000
IOWeight=1000
MemoryLow=14G
# Hard floors: Neo4j 5G (heap max 3G + page cache 2G) + backend 6G = 11G. memory.low alone was overridden under host
# pressure: 31 Oct 76,145 low events and 242 MB of Neo4j swapped 01:04-01:07; 1 Nov 00:16 a fleet test burst swapped
# 1.4 GB of the backend out while it used 3.6 GB, under its 6G memory.low (host_load_minute), and request threads stalled
# 5-6 s on swap-in. A child's memory.min is capped by its parents', so both slices carry the sum. The Neo4j scope gets
# its floor from headless/hostpolicy-sweep.sh, since a docker scope is transient.
MemoryMin=11G
