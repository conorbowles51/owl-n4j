# lx-hostpolicy (WS-A, LOUPE-PERFORMANCE-PLAN.md). Sizes from the memory table in /mnt/owl-data/fin-wt/headless/LX-HOSTPOLICY-STATUS.md.
# The live service: owl-backend-v2, nginx (or owl-frontend-v2 when vite serves), and the owl-v2 Postgres, Neo4j and Redis containers.
[Unit]
Description=Loupe live service (people's requests first)
[Slice]
CPUWeight=1000
IOWeight=1000
MemoryLow=14G
# Hard floor for Neo4j (heap max 3G + page cache 2G): memory.low alone was overridden under host pressure
# (31 Oct: 76,145 low events since 00:30; 242 MB of Neo4j swapped between 01:04 and 01:07). The Neo4j scope gets the same floor from
# headless/hostpolicy-sweep.sh, since a docker scope is transient.
MemoryMin=5G
