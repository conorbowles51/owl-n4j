# Per-minute host load and a 10 s availability probe into Postgres (backend/scripts/host_recorder.py).
# Install: cp deploy/loupe-host-recorder.service /etc/systemd/system/ && systemctl daemon-reload
#          && systemctl enable --now loupe-host-recorder.service
# Way back: systemctl disable --now loupe-host-recorder.service && rm /etc/systemd/system/loupe-host-recorder.service
#           (the tables stay; nothing reads them on a request path)
[Unit]
Description=Loupe host load and availability recorder
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/home/conorbowles51/app-v3/owl-n4j/backend
EnvironmentFile=/home/conorbowles51/app-v3/owl-n4j/.env
ExecStart=/home/conorbowles51/app-v3/owl-n4j/.venv/bin/python -I scripts/host_recorder.py
Restart=always
RestartSec=10
# In the live app's slice, capped at 5% of one core: it uses about 0.3% (measured by its own recorder_cpu_ms),
# but it must get that CPU on time. In the fleet's low-weight slice (first install, 01:14-01:20 on 31 Oct) it was
# starved under 74% host CPU pressure: minutes 29-112 s long, a missing minute, and probe times that included its
# own wait for a CPU.
Slice=loupe.slice
CPUQuota=5%
MemoryMax=128M
IOWeight=20

[Install]
WantedBy=multi-user.target
